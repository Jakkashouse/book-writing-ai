{
  "_comment": "세미나 5/13 — 마케팅 자동화 3-에이전트 팀 설정",
  "_version": "v1",
  "_created_at": "2026-04-21",
  "_description": "TeamCreate API로 3에이전트를 하나의 완결 파이프라인으로 묶기 위한 설정",

  "team_name": "marketing-automation-team",
  "team_description": "1인 기업 마케팅 3-에이전트 완결 파이프라인. 생성 → 발행 → 분석 순환.",

  "members": [
    {
      "agent_name": "content-creator",
      "role": "콘텐츠 생성",
      "trigger_keywords": ["생성", "작성", "초안", "글쓰기", "create", "draft"],
      "input_schema": {
        "topic": "string (한 줄 주제)",
        "target_audience": "string (선택, 기본값: 1인 사업자)"
      },
      "output_schema": {
        "folder": "outputs/{date}-{topic-slug}/",
        "files": ["blog.md", "instagram.txt", "youtube-hook.md"]
      }
    },
    {
      "agent_name": "sns-publisher",
      "role": "SNS 포맷 변환 + 예약 발행",
      "trigger_keywords": ["발행", "업로드", "publish", "post", "게시"],
      "input_schema": {
        "content_folder": "string (content-creator 출력 폴더)",
        "schedule_start": "ISO 8601 datetime (선택, 기본 다음날 09:00)"
      },
      "output_schema": {
        "queue_file": ".claude/publish-queue.json",
        "scheduled_posts": 3
      },
      "depends_on": "content-creator"
    },
    {
      "agent_name": "insight-analyzer",
      "role": "주간 성과 분석 + 다음주 방향 제안",
      "trigger_keywords": ["분석", "리포트", "성과", "analyze", "report"],
      "input_schema": {
        "date_range": "string (예: last_7_days)",
        "platforms": "array (선택, 기본 all)"
      },
      "output_schema": {
        "report_file": "reports/weekly-{YYYY-MM-DD}.md",
        "top3": "array",
        "bottom3": "array",
        "next_week_topics": "array (5개 제안)"
      },
      "depends_on": "sns-publisher"
    }
  ],

  "routing_rules": [
    {
      "rule": "keyword_match",
      "priority": 1,
      "description": "사용자 입력에서 trigger_keywords 매칭되는 에이전트 자동 호출"
    },
    {
      "rule": "pipeline_chain",
      "priority": 2,
      "description": "사용자가 '주제만 던지고 싶다' 할 때 생성 → 발행 → (7일 후) 분석 자동 연결"
    },
    {
      "rule": "manual_override",
      "priority": 3,
      "description": "특정 에이전트만 실행하고 싶을 때 /content-create, /sns-publish, /insight-analyze 직접 호출"
    }
  ],

  "shared_state": {
    "_path": ".claude/team-state.json",
    "fields": [
      "current_campaign",
      "last_topic_generated",
      "last_publish_date",
      "last_analysis_date",
      "pending_posts_count"
    ]
  },

  "pipeline_example": {
    "trigger": "/team marketing '1인 사업자 노트북 가방 추천'",
    "steps": [
      "1. content-creator 실행 → outputs/2026-05-14-노트북가방/ 생성 (3종)",
      "2. sns-publisher 실행 → .claude/publish-queue.json에 예약 3건 추가",
      "3. 오전 9시 launchd 트리거 → 실제 발행 (본 강의 Part 6에서 MCP 연동)",
      "4. 7일 후 월요일 insight-analyzer 실행 → reports/weekly-{date}.md 생성"
    ],
    "total_autonomy": "주제 1회 입력 → 7일 후 성과 리포트 자동 수신 (사용자 개입 0회)"
  },

  "hooks": [
    {
      "event": "content-creator:complete",
      "action": "auto-trigger sns-publisher"
    },
    {
      "event": "sns-publisher:queued",
      "action": "log to team-state.json"
    },
    {
      "event": "schedule:monday 09:00",
      "action": "auto-trigger insight-analyzer"
    }
  ],

  "scaling_path": {
    "v1_current": "3에이전트 (본 세미나 완성)",
    "v2_next": "본 강의 Part 6 마케팅부 = 5에이전트 (콘텐츠/퍼블리셔/인사이트 + SEO + 광고)",
    "v3_full": "본 강의 7부서 30에이전트 전체 조직"
  }
}
