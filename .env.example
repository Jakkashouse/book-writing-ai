# =============================================================================
# 마케팅 자동화 키 보관소 (작가의집)
# =============================================================================
# 사용법:
#   1. 이 파일을 .env 로 복사
#   2. 아래 키를 발급받아 채워넣기
#   3. .env 는 절대 커밋 금지 (.gitignore 등록 확인 완료)
#
# 발급 가이드는 docs/MARKETING_SETUP.md 참고

# -----------------------------------------------------------------------------
# Make.com (백오피스 자동화 허브)
# -----------------------------------------------------------------------------
# 발급처: https://www.make.com → Scenarios → 새 시나리오 → Webhook 모듈 추가
# 권한: Core plan ($9/월, 10,000 ops)
MAKE_WEBHOOK_URL=https://hook.eu2.make.com/xxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Buffer (SNS 예약 발행 + 검수 UI)
# -----------------------------------------------------------------------------
# 발급처: https://publish.buffer.com → Account → Apps & Extras → API Access Token
# 현재 플랜: Essentials ($6/월) — 유지
BUFFER_ACCESS_TOKEN=1/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Buffer 프로필 ID (인스타/페이스북/트위터/링크드인 등 각 채널 ID)
# 발급처: GET https://api.bufferapp.com/1/profiles.json?access_token=YOUR_TOKEN
BUFFER_PROFILE_INSTAGRAM=xxxxxxxxxxxxxxxxxxxxxxxx
BUFFER_PROFILE_FACEBOOK=xxxxxxxxxxxxxxxxxxxxxxxx
BUFFER_PROFILE_TWITTER=xxxxxxxxxxxxxxxxxxxxxxxx
BUFFER_PROFILE_LINKEDIN=xxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# (선택) 직접 발행용 — Make 없이 클로드에서 바로 쏠 때만 필요
# -----------------------------------------------------------------------------
# INSTAGRAM_ACCESS_TOKEN=
# META_BUSINESS_ID=
